# ==============================================================================
# CineScout Environment Configuration
# ==============================================================================

# [REQUIRED] Google Gemini API Key
# Obtain your free or paid API key at: https://aistudio.google.com/app/apikey
# In Vercel: Add this in Project Settings > Environment Variables > GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here

# [OPTIONAL] Gemini Model Alias (Default: gemini-2.5-flash or gemini-3.7-flash)
GEMINI_MODEL=gemini-2.5-flash

# [OPTIONAL] Host App URL
APP_URL=https://your-app.vercel.app
